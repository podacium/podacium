  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@index([createdAt])
}

model MessageReadReceipt {
  id        Int      @id @default(autoincrement())
