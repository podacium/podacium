  resolutionNotes String?
  resolvedAt      DateTime?
  resolvedById    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review   ContractReview @relation(fields: [reviewId], references: [id])
  appealer User           @relation("ReviewAppeals", fields: [appealerId], references: [id])

  @@index([reviewId])
  @@index([status])
}

