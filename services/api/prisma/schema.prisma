  city                  City      @default(ALGIERS)
  status                KybStatus @default(NOT_SUBMITTED)
  riskScore             Int       @default(0)
  rejectionReason       String?
  verifiedAt            DateTime?
  verifiedBy            Int? // AdminProfile ID
  qrVerifiedAt          DateTime?
  qrVerificationReceipt Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verifierProfile  AdminProfile?        @relation("AdminKybVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  documents        CorporateDocument[]
  verificationLogs OrganizationKybLog[]

  @@index([status])
  @@index([rcNumber])
  @@index([nifNumber])
  @@index([rcWilayaCode])
}

model CorporateDocument {
  id               Int                   @id @default(autoincrement())
  kybId            Int
  documentType     CorporateDocumentType
  storageKey       String // MinIO/S3 Sovereign Vault Key
  fileName         String
  mimeType         String                @default("application/pdf")
  fileSize         Int
  fileSha256       String
  isEncrypted      Boolean               @default(true)
  qrCodeVerified   Boolean               @default(false)
  qrCodeRawData    String?
  ocrExtractedData Json?
  uploadedAt       DateTime              @default(now())
  verifiedAt       DateTime?

  kyb OrganizationKyb @relation(fields: [kybId], references: [id], onDelete: Cascade)

  @@index([kybId, documentType])
  @@index([fileSha256])
}

model OrganizationKybLog {
  id             Int       @id @default(autoincrement())
  kybId          Int
  adminId        Int?
  previousStatus KybStatus
  newStatus      KybStatus
  reason         String?
  metadata       Json?
  createdAt      DateTime  @default(now())

  kyb   OrganizationKyb @relation(fields: [kybId], references: [id], onDelete: Cascade)
  admin AdminProfile?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([kybId])
  @@index([createdAt])
}

model Department {
  id             Int       @id @default(autoincrement())
  organizationId Int
  name           String
  slug           String
  code           String? // Cost Center code / Centre de coût
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]
  datasets     Dataset[]
  dashboards   Dashboard[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Branch {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  code           String? // e.g., ORN-01, ALG-01
  wilayaCode     Int // 1 to 58
  city           City
  address        String?
  phoneNumber    String?
  isHeadquarters Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([wilayaCode])
}

model TeamLicensePool {
  id             Int       @id @default(autoincrement())
  organizationId Int
  moduleId       String?
  pathId         String?
  totalSeats     Int
  allocatedSeats Int       @default(0)
  purchasedAt    DateTime  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  allocations  SeatAllocation[]

  @@index([organizationId])
}

model SeatAllocation {
  id         Int       @id @default(autoincrement())
  poolId     Int
  userId     Int
  assignedAt DateTime  @default(now())
  revokedAt  DateTime?

  pool TeamLicensePool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([poolId, userId])
  @@index([userId])
}

model CompanyCaseStudy {
  id               Int          @id @default(autoincrement())
  organizationId   Int
  title            String
  slug             String
  clientName       String?
  industry         String?
  problemStatement String
  solutionSummary  String
  roiMetrics       Json? // e.g., [{"label": "Cost Reduction", "value": "42%"}]
  technologies     String[]     @default([])
  isFeatured       Boolean      @default(false)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model CompanyLeadership {
  id             Int          @id @default(autoincrement())
  organizationId Int
  fullName       String
  roleTitle      String // e.g., "PDG / CEO", "DAF", "CTO"
  bio            String?
  avatarUrl      String?
  linkedinUrl    String?
  displayOrder   Int          @default(0)
  isExecutive    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, displayOrder])
}

model CompanyReview {
  id                      Int          @id @default(autoincrement())
  organizationId          Int
  reviewerId              Int
  contractId              Int?
  reviewerType            String       @default("FREELANCER") // FREELANCER | CLIENT | CORPORATE_LEARNER
  overallRating           Float
  paymentPromptnessRating Float?
  scopeClarityRating      Float?
  communicationRating     Float?
  title                   String?
  comment                 String?
  isVerifiedContract      Boolean      @default(false)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reviewerId, contractId])
  @@index([organizationId])
  @@index([reviewerId])
}

