generator client {
  provider                    = "prisma-client-py"
  output                      = "../app/generated/prisma"
  enable_experimental_decimal = "true"
  recursive_type_depth        = -1
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Preserved for future licensed PSP operations under Bank of Algeria Regulation 25-02
model Wallet {
  id                 Int                 @id @default(autoincrement())
  userId             Int?                @unique
  organizationId     Int?                @unique
  podaPoints         Int                 @default(0)
  currency           String              @default("PODAPOINT")
  isActive           Boolean             @default(true)
  lastTopUpAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  escrowHolds        EscrowHold[] // Preserved for future licensed PSP operations under Bank of Algeria Regulation 25-02
  payouts            Payout[] // Preserved for future licensed PSP operations under Bank of Algeria Regulation 25-02
  walletTransactions Transaction[]
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       WalletTransaction[]

  @@index([userId])
  @@index([organizationId])
  @@index([podaPoints])
  @@index([isActive])
  @@index([createdAt])
}

/// Preserved for future licensed PSP operations under Bank of Algeria Regulation 25-02
model EscrowHold {
  id                 Int           @id @default(autoincrement())
  contractId         Int           @unique
  walletId           Int
  amount             Int
  currency           String        @default("DZD")
  status             String        @default("HOLD")
  releaseConditions  Json?
  scheduledReleaseAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  releasedAt         DateTime?
  refundedAt         DateTime?
  releasedAmount     Int           @default(0)
  contract           Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  wallet             Wallet        @relation(fields: [walletId], references: [id])
  transactions       Transaction[]

  @@index([contractId])
  @@index([walletId])
  @@index([status])
  @@index([scheduledReleaseAt])
  @@index([createdAt])
}

model WalletTransaction {
  id              Int            @id @default(autoincrement())
  walletId        Int
  amount          Int
  previousBalance Int
  newBalance      Int
  type            String
  purpose         PaymentPurpose
  referenceId     String?
  description     String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime?      @updatedAt
  wallet          Wallet         @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([referenceId])
  @@index([type])
  @@index([purpose])
  @@index([createdAt])
  @@index([walletId, createdAt])
}

model FreelancerProfile {
  id                      Int            @id @default(autoincrement())
  userId                  Int            @unique
  tier                    FreelancerTier @default(NEW)
  commissionRate          Decimal        @default(0.0) @db.Decimal(5, 2) // Preserved for future PSP operations
  completedProjects       Int            @default(0)
  totalEarned             Int            @default(0) // Preserved for future PSP operations
  platformFee             Int            @default(0) // Preserved for future PSP operations
  isVerified              Boolean        @default(false)
  featured                Boolean        @default(false)
  featuredBoost           Float          @default(0.0) // decayable boost score (1.0 → 0 over 7d)
  featuredUntil           DateTime?
  isPremium               Boolean        @default(false)
  skillPassportVerified   Boolean        @default(false)
  skillPassportVerifiedAt DateTime?
  isAnaeRegistered        Boolean        @default(false) // Loi 22-23 Auto-Entrepreneur status
  anaeCardNumber          String?
  ribCcpNumber            String?
  metadata                Json?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  contracts               Contract[]
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tier])
  @@index([commissionRate])
  @@index([completedProjects])
  @@index([isVerified])
}

model StudentProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  headline           String?
  learningGoals      String?
  careerPath         String?
  totalLearningHours Float    @default(0)
  completedCourses   Int      @default(0)
  averageQuizScore   Float?
  bestSubject        String?
  badges             Json?
  wishlist           Int[]    @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InstructorProfile {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  headline           String?
  totalStudents      Int       @default(0)
  totalCourses       Int       @default(0)
  totalCourseHours   Float     @default(0)
  averageRating      Float?
  reviewCount        Int       @default(0)
  responseRate       Float?
  responseTimeHours  Int?
  languages          String[]  @default([])
  credentials        Json?
  workExperience     Json?
  publications       Json?
  teachingCategories String[]  @default([])
  featuredCourseId   Int?
  instructorSince    DateTime  @default(now())
  lastCourseUpdate   DateTime?
  satisfactionRate   Float?
  curriculumVitae    String?
  researchInterests  String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([averageRating])
}

model BusinessProfile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  headline          String?
  companyRole       String?
  department        String?
  industry          String?
  companySize       String?
  yearsOfExperience Int?
  areasOfExpertise  String[] @default([])
  linkedIn          String?
  portfolioUrl      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FreelancerService {
  id                  Int       @id @default(autoincrement())
  userId              Int
  title               String
  description         String
  category            String
  subcategory         String?
  pricingType         String
  price               Float?
  basicPrice          Float?
  basicDescription    String?
  standardPrice       Float?
  standardDescription String?
  premiumPrice        Float?
  premiumDescription  String?
  deliveryDays        Int?
  revisions           Int       @default(0)
  images              String[]  @default([])
  video               String?
  isActive            Boolean   @default(true)
  isBoosted           Boolean   @default(false)
  boostExpiresAt      DateTime?
  orderCount          Int       @default(0)
  averageRating       Float?
  reviewCount         Int       @default(0)
  viewCount           Int       @default(0)
  tags                String[]  @default([])
  faq                 Json?
  requirements        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([category, subcategory])
  @@index([isActive, isBoosted])
}

model SkillEndorsement {
  id         Int      @id @default(autoincrement())
  skillName  String
  endorserId Int
  endorsedId Int
  createdAt  DateTime @default(now())
  endorser   User     @relation("Endorser", fields: [endorserId], references: [id])
  endorsed   User     @relation("EndorsedUser", fields: [endorsedId], references: [id])

  @@unique([skillName, endorserId, endorsedId])
  @@index([endorsedId, skillName])
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id])
  following   User     @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model OrgProfile {
  id                  Int          @id @default(autoincrement())
  organizationId      Int          @unique
  longDescription     String?
  specialties         String[]     @default([])
  technologies        String[]     @default([])
  competitors         String[]     @default([])
  fundingRound        String?
  fundingAmount       Float?
  revenueRange        String?
  products            Json?
  jobs                Json?
  culture             String?
  benefits            String?
  mission             String?
  achievements        Json?
  certifications      String[]     @default([])
  mapLocation         Json?
  algerianHealthScore Float?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model OrgReview {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  rating         Int
  title          String?
  comment        String?
  isRecommended  Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([rating])
}

model OrgFollow {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model PublicDashboard {
  id             Int           @id @default(autoincrement())
  organizationId Int?
  userId         Int?
  title          String
  description    String?
  thumbnailUrl   String?
  tags           String[]      @default([])
  isPublic       Boolean       @default(false)
  viewCount      Int           @default(0)
  likeCount      Int           @default(0)
  embedUrl       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, isPublic])
  @@index([userId, isPublic])
}

/// Preserved for future licensed PSP operations under Bank of Algeria Regulation 25-02
model Payout {
  id                Int             @id @default(autoincrement())
  walletId          Int
  amount            Int
  currency          String          @default("DZD")
  method            PaymentProvider @default(BANK_TRANSFER)
  status            String          @default("PENDING")
  reference         String?
  metadata          Json?
  requestedAt       DateTime        @default(now())
  processedAt       DateTime?
  completedAt       DateTime?
  accountHolderName String?
  accountNumber     String?
  adminNotes        String?
  bankName          String?
  batchId           String?
  notes             String?
  wallet            Wallet          @relation(fields: [walletId], references: [id])
  updatedAt         DateTime?       @updatedAt

  @@index([walletId])
  @@index([status])
  @@index([requestedAt])
  @@index([method])
  @@index([reference])
  @@index([batchId])
}

model User {
  id                        Int                       @id @default(autoincrement())
  username                  String?                   @unique
  slug                      String?
  email                     String?                   @unique
  role                      UserRole                  @default(STUDENT)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  acceptedTerms             Boolean                   @default(false)
  bio                       String?
  headline                  String?
  tagline                   String?
  pronouns                  String?
  deletedAt                 DateTime?
  emailVerified             Boolean                   @default(false)
  emailVerifiedAt           DateTime?
  fullName                  String
  passwordHash              String?
  phoneNumber               String?                   @unique
  phoneVerified             Boolean                   @default(false)
  phoneVerifiedAt           DateTime?
  primaryOrganizationId     Int?
  profilePictureUrl         String?
  coverImageUrl             String?
  provider                  AuthProvider              @default(EMAIL)
  providerId                String?
  skills                    String[]                  @default([])
  /// Maintained by the arabic_search migration and app startup (tsvector is
  /// not natively supported by Prisma). Declared so `db push` never drops it.
  search_vector             Unsupported("tsvector")?
  socialLinks               Json?
  availability              String                    @default("AVAILABLE")
  timezone                  String?
  profileViewCount          Int                       @default(0)
  lastActiveAt              DateTime?
  subscribeNewsletter       Boolean                   @default(false)
  isActive                  Boolean                   @default(true)
  isDeactivated             Boolean                   @default(false)
  onboardingCompleted       Boolean                   @default(false)
  deactivatedAt             DateTime?
  lastLoginAt               DateTime?
  lastPasswordChangeAt      DateTime?
  loginCount                Int                       @default(0)
  country                   Country?
  city                      City?
  deletionRequests          AccountDeletionRequest[]
  advancedSettings          AdvancedSettings?
  authTokens                AuthToken[]
  certificates              Certificate[]
  contractsAsClient         Contract[]                @relation("ContractClient")
  contractsAsFreelancer     Contract[]
  authoredReviews           ContractReview[]          @relation("AuthoredReviews")
  receivedReviews           ContractReview[]          @relation("ReceivedReviews")
  reviewAppeals             ReviewAppeal[]            @relation("ReviewAppeals")
  reviewReports             ReviewReport[]            @relation("ReviewReports")
  platformAppeals           PlatformAppeal[]          @relation("UserPlatformAppeals")
  resolvedPlatformAppeals   PlatformAppeal[]          @relation("ResolvedPlatformAppeals")
  initiatedAdminActions     PendingAdminAction[]      @relation("InitiatedAdminActions")
  approvedAdminActions      PendingAdminAction[]      @relation("ApprovedAdminActions")
  courseReviews             CourseReview[]
  conversationParticipants  ConversationParticipant[]
  dashboards                Dashboard[]
  dataConnectors            DataConnector[]
  dataExports               DataExport[]
  datasets                  Dataset[]
  enrollments               Enrollment[]
  files                     File[]
  freelancerProfile         FreelancerProfile?
  idempotencyKeys           IdempotencyKey[]
  insights                  Insight[]
  sentInvitations           Invitation[]              @relation("SentInvitations")
  lessonProgresses          LessonProgress[]
  mlModels                  MLModel[]                 @relation("MLModelCreator")
  messages                  Message[]
  messageReactions          MessageReaction[]
  messageReadReceipts       MessageReadReceipt[]
  instructedModules         Module[]                  @relation("ModuleInstructor")
  reviewedModules           Module[]                  @relation("ModuleReviewer")
  notifications             Notification[]
  notificationPrefs         NotificationPreferences?
  ownedOrganizations        Organization[]            @relation("OrgOwner")
  seatAllocations           SeatAllocation[]
  invoices                  Invoice[]
  sentInvites               OrganizationMember[]      @relation("OrgInvites")
  memberships               OrganizationMember[]      @relation("UserMemberships")
  paymentMethods            PaymentMethod[]
  projects                  Project[]
  proposals                 Proposal[]
  quizAttempts              QuizAttempt[]
  securitySettings          SecuritySettings?
  subscriptions             Subscription[]
  transactions              Transaction[]
  usageTrackings            UsageTracking[]
  primaryOrganization       Organization?             @relation("PrimaryUsers", fields: [primaryOrganizationId], references: [id], onDelete: Restrict)
  devices                   UserDevice[]
  webauthnCredentials       WebAuthnCredential[]
  emailOtpCodes             EmailOtpCode[]
  securityEvents            SecurityEvent[]
  deviceCooldowns           DeviceCooldown[]
  securityStrikes           Int                       @default(0)
  accountRestricted         Boolean                   @default(false)
  accountRestrictedAt       DateTime?
  userSettings              UserSettings?
  appearanceSettings        AppearanceSettings?
  privacySettings           PrivacySettings?
  integrations              UserIntegration[]
  apiKeys                   ApiKey[]
  webhookEndpoints          WebhookEndpoint[]
  workflows                 IntegrationWorkflow[]
  skillsDetails             UserSkill[]
  wallet                    Wallet?
  createdDisputes           Dispute[]                 @relation("DisputeCreator")
  resolvedDisputes          Dispute[]                 @relation("DisputeResolver")
  receivedDisputes          Dispute[]                 @relation("DisputeOpponent")
  onboardingAnswer          OnboardingAnswer?
  biAuditLogs               BiAuditLog[]
  decisions                 Decision[]
  decisionHistories         DecisionHistory[]
  decisionComments          DecisionComment[]
  reports                   Report[]
  dashboardTemplates        DashboardTemplate[]
  CrossPillarEvent          CrossPillarEvent[]
  tickets                   Ticket[]                  @relation("UserTickets")
  assignedTickets           Ticket[]                  @relation("AssignedTickets")
  ticketMessages            TicketMessage[]           @relation("TicketMessageSender")
  liveSessionsCreated       LiveSession[]             @relation("LiveSessionOwner")
  liveSessionParticipations LiveSessionParticipant[]
  liveSessionBookings       LiveSessionBooking[]
  liveSessionCoHosted       LiveSessionCoHost[]
  liveSessionWaitlists      LiveSessionWaitlist[]
  hostCoupons               HostCoupon[]
  liveSessionReviews        LiveSessionReview[]
  liveSessionChatMessages   LiveSessionChatMessage[]
  portfolioItems            PortfolioItem[]
  featurePurchases          FeaturePurchase[]         @relation("UserFeaturePurchases")
  studentProfile            StudentProfile?
  instructorProfile         InstructorProfile?
  businessProfile           BusinessProfile?
  freelancerServices        FreelancerService[]
  skillEndorsementsGiven    SkillEndorsement[]        @relation("Endorser")
  skillEndorsementsReceived SkillEndorsement[]        @relation("EndorsedUser")
  followers                 UserFollow[]              @relation("Following")
  following                 UserFollow[]              @relation("Followers")
  blockedUsers              UserBlock[]               @relation("Blocker")
  blockedBy                 UserBlock[]               @relation("Blocked")
  usernameHistory           UsernameRedirect[]
  orgReviews                OrgReview[]
  orgFollows                OrgFollow[]
  publicDashboards          PublicDashboard[]
  authoredDashboardComments DashboardComment[]        @relation("CommentAuthor")
  resolvedDashboardComments DashboardComment[]        @relation("CommentResolver")
  dashboardBookmarks        DashboardBookmark[]
  dashboardSnapshots        DashboardSnapshot[]
  dashboardShareLinks       DashboardShareLink[]
  videoUploadSessions       VideoUploadSession[]
  kyc                       UserKyc?
  adminProfile              AdminProfile?             @relation("UserAdminProfile")
  mailAccounts              MailAccount[]             @relation("UserMailAccounts")
  emailAuditLogs            EmailAuditLog[]           @relation("EmailAuditActor")
  aiSessions                AiSession[]               @relation("UserAiSessions")
  aiLogs                    AiLog[]                   @relation("UserAiLogs")
  confirmedAiIntents        AiActionIntent[]          @relation("ConfirmedAiIntents")

  @@index([search_vector], map: "user_search_idx", type: Gin)
  @@index([email])
  @@index([role, isActive, deletedAt])
  @@index([phoneVerified])
  @@index([skills])
  @@index([fullName])
  @@index([city, country])
  @@index([provider, providerId])
  @@index([lastLoginAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([isActive, role])
  @@index([emailVerified, email])
}

model UsernameRedirect {
  id          Int      @id @default(autoincrement())
  oldUsername String   @unique
  newUserId   Int
  changedAt   DateTime @default(now())
  expiresAt   DateTime
  user        User     @relation(fields: [newUserId], references: [id])

  @@index([oldUsername])
  @@index([expiresAt])
  @@index([newUserId])
}

model ReservedUsername {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model OnboardingAnswer {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  role            String?
  primaryGoal     String?
  experienceLevel String?
  fieldOfInterest String?
  weeklyTime      String?
  discoverySource String?
  openAnswer      String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Organization {
  id                 Int                  @id @default(autoincrement())
  slug               String?              @unique
  name               String
  description        String?
  website            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  ownerId            Int?
  city               City                 @default(ALGIERS)
  sector             OrganizationSector   @default(TECHNOLOGY_AND_SOFTWARE)
  country            Country              @default(ALGERIA)
  dashboards         Dashboard[]
  datasets           Dataset[]
  decisions          Decision[]
  reports            Report[]
  dashboardTemplates DashboardTemplate[]
  invitations        Invitation[]
  owner              User?                @relation("OrgOwner", fields: [ownerId], references: [id])
  members            OrganizationMember[]
  paymentMethods     PaymentMethod[]
  projects           Project[]
  subscriptions      Subscription[]
  transactions       Transaction[]
  usageTrackings     UsageTracking[]
  primaryUsers       User[]               @relation("PrimaryUsers")
  wallet             Wallet?
  biAuditLogs        BiAuditLog[]
  CrossPillarEvent   CrossPillarEvent[]
  dataConnectors     DataConnector[]
  semanticModels     SemanticModel[]
  rowLevelPolicies   RowLevelPolicy[]
  orgProfile         OrgProfile?
  reviews            OrgReview[]
  followers          OrgFollow[]
  publicDashboards   PublicDashboard[]
  kyb                OrganizationKyb?
  departments        Department[]
  branches           Branch[]
  teamLicensePools   TeamLicensePool[]
  caseStudies        CompanyCaseStudy[]
  leadership         CompanyLeadership[]
  companyReviews     CompanyReview[]
  invoices           Invoice[]
  nisNumber          String?
  nifNumber          String?
  rcNumber           String?
  articleImposition  String?
  taxRegime          String?
  verifiedDomains    String[]             @default([])
  samlEntityId       String?
  samlMetadataUrl    String?
  scimEnabled        Boolean              @default(false)
  tagline            String?
  companySizeBracket String?              @default("MICRO_1_10")
  operationalScale   String?              @default("NATIONAL_58_WILAYAS")
  primaryLanguages   String[]             @default(["FRENCH", "ARABIC"])
  isPublic           Boolean              @default(true)
  internalBulletin   String?
  timeZone           String?              @default("Africa/Algiers")
  keyContacts        Json?
  hqAddress          String?
  brandAccentColor   String?              @default("#1B4D3E")
  coverBannerUrl     String?
  socialLinks        Json?
  mailAccounts       MailAccount[]        @relation("OrgMailAccounts")
  aiSessions         AiSession[]          @relation("OrgAiSessions")

  @@index([name])
  @@index([ownerId])
  @@index([createdAt])
  @@index([sector])
  @@index([country])
  @@index([city])
  @@index([isPublic])
}

model Invitation {
  id             Int          @id @default(autoincrement())
  email          String
  role           String       @default("MEMBER")
  token          String       @unique
  organizationId Int
  inviterId      Int
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  inviter        User         @relation("SentInvitations", fields: [inviterId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@index([token])
}

model OrganizationMember {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  role           String?
  invitedById    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  invitedBy      User?        @relation("OrgInvites", fields: [invitedById], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation("UserMemberships", fields: [userId], references: [id])
  departmentId   Int?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@index([invitedById])
  @@index([departmentId])
  @@index([createdAt])
}

model Path {
  id              String        @id
  title           String
  description     String?
  durationMinutes Int?          @default(0)
  totalLessons    Int?          @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  featured        Boolean       @default(false)
  price           Json?
  thumbnailUrl    String?
  certificates    Certificate[]
  enrollments     Enrollment[]
  modules         PathModule[]

  @@index([createdAt])
  @@index([title])
  @@index([deletedAt])
  @@index([featured])
  @@index([createdAt, featured])
}

model Module {
  id               String                  @id
  title            String
  description      String?
  fullDescription  String?
  durationMinutes  Int?
  estimatedEffort  String?
  totalLessons     Int?                    @default(0)
  level            String?
  instructorId     Int?
  status           ModuleStatus            @default(DRAFT)
  publishedAt      DateTime?
  reviewedBy       Int?
  rejectionReason  String?
  submittedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?
  skills           String[]                @default([])
  tags             String[]                @default([])
  /// See User.search_vector — maintained by SQL, declared to protect it.
  search_vector    Unsupported("tsvector")?
  featured         Boolean                 @default(false)
  lastUpdated      DateTime?
  price            Json?
  thumbnailUrl     String?
  certificates     Certificate[]
  enrollments      Enrollment[]
  lessons          Lesson[]
