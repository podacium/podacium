  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reviewerId, contractId])
  @@index([organizationId])
  @@index([reviewerId])
}


enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE_SIMULATION
  FUNDED_SIMULATION
  CLOSED
}

enum AnalystLevel {
  NOVICE
  SCOUT
  ANALYST
  PARTNER
}

model Startup {
  id              String         @id @default(uuid())
  name            String
  tagline         String
  description     String
  logoUrl         String?
  pitchDeckUrl    String?
  videoPitchUrl   String?
  founderId       Int
  founder         User           @relation(fields: [founderId], references: [id])
  wilaya          Int
  sector          String
  hasAsfLabel     Boolean        @default(false)
  campaigns       Campaign[]
  dueDiligence    CommunityScore[]
  hypeScore       Float          @default(0.0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Campaign {
  id              String         @id @default(uuid())
  startupId       String
  startup         Startup        @relation(fields: [startupId], references: [id])
  targetAmountDzd Int
  raisedAmountDzd Int            @default(0)
  minTicketDzd    Int            @default(5000)
  status          CampaignStatus @default(ACTIVE_SIMULATION)
  startDate       DateTime       @default(now())
  endDate         DateTime
  pledges         VirtualPledge[]
}

model VirtualPledge {
  id              String         @id @default(uuid())
  campaignId      String
  campaign        Campaign       @relation(fields: [campaignId], references: [id])
  userId          Int
  user            User           @relation(fields: [userId], references: [id])
  amountDzd       Int
  equitySharePct  Float?
  createdAt       DateTime       @default(now())
}

model CommunityScore {
  id              String         @id @default(uuid())
  startupId       String
  startup         Startup        @relation(fields: [startupId], references: [id])
  userId          Int
  user            User           @relation(fields: [userId], references: [id])
  analystLevel    AnalystLevel   @default(NOVICE)
  marketScore     Int
  teamScore       Int
  tractionScore   Int
  feedback        String?
  createdAt       DateTime       @default(now())

  @@unique([startupId, userId])
}

model FinancialQuizResult {
  id              String         @id @default(uuid())
  userId          Int
  user            User           @relation(fields: [userId], references: [id])
  moduleIndex     Int
  score           Int
  passed          Boolean
  completedAt     DateTime       @default(now())
}
