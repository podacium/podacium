enum DisputeReason {
  NON_DELIVERY
  POOR_QUALITY
  INCOMPLETE_REQUIREMENTS
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CANCELLED
}

model Dispute {
  id         Int @id @default(autoincrement())
  contractId Int @unique
  creatorId  Int // User who opened the dispute
  opponentId Int // The other party

  reason      DisputeReason
  description String
  status      DisputeStatus @default(OPEN)

  // Evidence / Metadata
  metadata Json? // Links to messages, files, etc.

  // Resolution details
  resolutionNotes  String?
  resolutionReason String? // Machine-readable reason code (e.g. "AUTO_TIMEOUT", "ADMIN_RULING")
  resolvedAt       DateTime?
  resolvedById     Int? // Admin user who resolved it (null = auto-resolved)
  autoResolvedAt   DateTime? // Set when Celery auto-resolution fires
  escalatedAt      DateTime? // Set when dispute is escalated to admin

  // Milestone relation
  milestoneId Int? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contract     Contract           @relation(fields: [contractId], references: [id])
  creator      User               @relation("DisputeCreator", fields: [creatorId], references: [id])
  opponent     User               @relation("DisputeOpponent", fields: [opponentId], references: [id])
  resolvedBy   User?              @relation("DisputeResolver", fields: [resolvedById], references: [id])
  milestone    ContractMilestone? @relation("MilestoneDispute", fields: [milestoneId], references: [id])
  mailThreads  MailThread[]       @relation("DisputeMailThreads")
  mailMessages MailMessage[]

  @@index([status])
  @@index([contractId])
  @@index([createdAt])
  @@index([autoResolvedAt])
  @@index([milestoneId])
}

