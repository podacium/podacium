  verifiedKycs         UserKyc[]                    @relation("AdminKycVerifier")
  managedAssignments   AdminUserRoleAssignment[]    @relation("RoleAssignedBy")
  assignedMailAccounts MailAccountAdminAssignment[]
  verifiedKybs         OrganizationKyb[]            @relation("AdminKybVerifier")
  kybLogs              OrganizationKybLog[]

  @@index([userId])
  @@index([department, isActive])
  @@index([clearanceLevel])
  @@index([isActive])
}

model AdminRole {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  name          String
  description   String?
  isSystem      Boolean  @default(false)
  hierarchyRank Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  permissions     AdminRolePermission[]
  userAssignments AdminUserRoleAssignment[]

  @@index([slug])
  @@index([hierarchyRank])
}

model AdminPermission {
  id          Int                   @id @default(autoincrement())
  code        String                @unique // e.g. "finance:gateways:write"
  name        String
  domain      AdminPermissionDomain
  description String?
  isDangerous Boolean               @default(false)
  createdAt   DateTime              @default(now())

  rolePermissions AdminRolePermission[]

  @@index([code])
  @@index([domain])
}

model AdminRolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int
  permissionId Int
  grantedAt    DateTime @default(now())

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model AdminUserRoleAssignment {
  id             Int       @id @default(autoincrement())
  adminProfileId Int
  roleId         Int
  assignedById   Int?
  expiresAt      DateTime?
  assignedAt     DateTime  @default(now())

  adminProfile AdminProfile  @relation(fields: [adminProfileId], references: [id], onDelete: Cascade)
  role         AdminRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   AdminProfile? @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([adminProfileId, roleId])
  @@index([adminProfileId])
  @@index([roleId])
}

model AdminAuditTrail {
  id             BigInt                @id @default(autoincrement())
  sequenceNumber BigInt                @unique
  adminProfileId Int?
  impersonatorId Int?
  action         String
  domain         AdminPermissionDomain
  resourceType   String
  resourceId     String?
  status         AuditActionStatus
  severity       AuditSeverity         @default(INFO)
  ipAddress      String
  userAgent      String?
  geoCountry     String?               @default("DZ")
  geoWilaya      Int?
  sessionId      String?
  mfaVerified    Boolean               @default(true)
  requestId      String?
  beforeState    Json?
  afterState     Json?
  metadata       Json?
  sha256Hash     String
  previousHash   String
  timestamp      DateTime              @default(now())

  adminProfile AdminProfile? @relation("AdminProfileAuditTrails", fields: [adminProfileId], references: [id], onDelete: SetNull)

  @@index([sequenceNumber])
  @@index([adminProfileId, timestamp])
  @@index([action, timestamp])
  @@index([domain, timestamp])
  @@index([severity, timestamp])
}

model AdminSession {
  id              String    @id @default(uuid())
  adminProfileId  Int
  tokenHash       String    @unique
  ipAddress       String
  userAgent       String?
  mfaVerified     Boolean   @default(false)
  hardwareKeyUsed Boolean   @default(false)
  expiresAt       DateTime
  revokedAt       DateTime?
  lastActivityAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())

  adminProfile AdminProfile @relation(fields: [adminProfileId], references: [id], onDelete: Cascade)

  @@index([adminProfileId, revokedAt])
  @@index([tokenHash])
}

enum PendingActionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
}

model PendingAdminAction {
  id              String              @id @default(uuid())
  actionType      String
  targetResource  String
  targetId        String?
  payload         Json
  status          PendingActionStatus @default(PENDING_APPROVAL)
  initiatorId     Int
  approverId      Int?
  rejectionReason String?
  approvalNotes   String?
  expiresAt       DateTime
  executedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  initiator User  @relation("InitiatedAdminActions", fields: [initiatorId], references: [id], onDelete: Cascade)
  approver  User? @relation("ApprovedAdminActions", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([actionType, status])
  @@index([initiatorId])
  @@index([approverId])
  @@index([status, expiresAt])
}

// ============================================================================
// PODACIUM MAIL SUITE ENUMS & MODELS
// ============================================================================

enum MailAccountType {
  PERSONAL
  DEPARTMENTAL
  SHARED
}

enum MailAccountStatus {
  ACTIVE
  DISCONNECTED
  AUTH_ERROR
  SYNCING
  DISABLED
}

enum MailboxType {
  INBOX
  SENT
  DRAFTS
  TRASH
  SPAM
  ARCHIVE
  STARRED
  CUSTOM
}

enum MailMessageStatus {
  RECEIVED
  QUEUED
  SENDING
  SENT
  FAILED
  DRAFT
  BOUNCED
}

enum MailPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model MailAccount {
  id             Int               @id @default(autoincrement())
  accountId      String            @unique @default(uuid())
  userId         Int?
  organizationId Int?
  emailAddress   String            @unique
  displayName    String
  type           MailAccountType   @default(PERSONAL)
  status         MailAccountStatus @default(ACTIVE)

  imapHost   String  @default("imap.purelymail.com")
  imapPort   Int     @default(993)
  imapUseSsl Boolean @default(true)
  smtpHost   String  @default("smtp.purelymail.com")
  smtpPort   Int     @default(465)
  smtpUseSsl Boolean @default(true)

  encryptedPassword String
  dekWrapped        String
  dekNonce          String

  lastSyncAt    DateTime?
  lastSyncError String?
  syncCursor    String?
  quotaBytes    BigInt?
  usedBytes     BigInt?   @default(0)
  signatureHtml String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user             User?                        @relation("UserMailAccounts", fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization?                @relation("OrgMailAccounts", fields: [organizationId], references: [id], onDelete: Cascade)
  mailboxes        Mailbox[]
  mailThreads      MailThread[]
  messages         MailMessage[]
  attachments      MailAttachment[]
  adminAssignments MailAccountAdminAssignment[]

  @@index([userId])
  @@index([organizationId])
  @@index([emailAddress])
  @@index([status])
  @@index([type])
}

model MailAccountAdminAssignment {
  id             Int      @id @default(autoincrement())
  mailAccountId  Int
  adminProfileId Int
  canRead        Boolean  @default(true)
  canSend        Boolean  @default(false)
  canManage      Boolean  @default(false)
  assignedAt     DateTime @default(now())

  mailAccount  MailAccount  @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  adminProfile AdminProfile @relation(fields: [adminProfileId], references: [id], onDelete: Cascade)

  @@unique([mailAccountId, adminProfileId])
  @@index([adminProfileId])
  @@index([mailAccountId])
}

model Mailbox {
  id            Int         @id @default(autoincrement())
  mailboxId     String      @unique @default(uuid())
  mailAccountId Int
  name          String
  remoteName    String
  type          MailboxType @default(CUSTOM)
  unreadCount   Int         @default(0)
  totalCount    Int         @default(0)
  uidValidity   BigInt?
  lastSeenUid   BigInt?
  parentId      Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  mailAccount  MailAccount   @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  parent       Mailbox?      @relation("MailboxHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subMailboxes Mailbox[]     @relation("MailboxHierarchy")
  messages     MailMessage[]

  @@unique([mailAccountId, remoteName])
  @@index([mailAccountId])
  @@index([mailAccountId, type])
}

model MailThread {
  id             Int      @id @default(autoincrement())
  threadId       String   @unique @default(uuid())
  mailAccountId  Int
  subject        String
  snippet        String?
  lastMessageAt  DateTime @default(now())
  messageCount   Int      @default(1)
  hasAttachments Boolean  @default(false)
  isUnread       Boolean  @default(true)
  isStarred      Boolean  @default(false)

  ticketId   Int?
  contractId Int?
  disputeId  Int?
  invoiceId  Int?
  moduleId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mailAccount MailAccount   @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  messages    MailMessage[]

  ticket   Ticket?   @relation("TicketMailThreads", fields: [ticketId], references: [id], onDelete: SetNull)
  invoice  Invoice?  @relation("InvoiceMailThreads", fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([mailAccountId])
  @@index([mailAccountId, lastMessageAt])
  @@index([ticketId])
  @@index([contractId])
  @@index([disputeId])
  @@index([invoiceId])
  @@index([moduleId])
}

model MailMessage {
  id                Int      @id @default(autoincrement())
  messageId         String   @unique @default(uuid())
  internetMessageId String?
  inReplyTo         String?
  references        String[] @default([])
  mailAccountId     Int
  mailboxId         Int
  threadId          Int?
  uid               BigInt?

  fromAddress    String
  fromName       String?
  toAddresses    String[]
  ccAddresses    String[] @default([])
  bccAddresses   String[] @default([])
  replyToAddress String?
  subject        String
  snippet        String?
  bodyText       String?
  bodyHtml       String?
  headers        Json?

  status         MailMessageStatus @default(RECEIVED)
  priority       MailPriority      @default(NORMAL)
  isRead         Boolean           @default(false)
  isStarred      Boolean           @default(false)
  isDraft        Boolean           @default(false)
  hasAttachments Boolean           @default(false)

  ticketId   Int?
  contractId Int?
  disputeId  Int?
  invoiceId  Int?
  moduleId   String?

  receivedAt DateTime?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  mailAccount MailAccount      @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  mailbox     Mailbox          @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  thread      MailThread?      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments MailAttachment[]

  ticket   Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([mailAccountId])
  @@index([mailboxId])
  @@index([threadId])
  @@index([internetMessageId])
  @@index([fromAddress])
  @@index([isRead, createdAt])
  @@unique([mailAccountId, internetMessageId])
  @@unique([mailboxId, uid])
  @@index([ticketId])
  @@index([contractId])
  @@index([disputeId])
  @@index([invoiceId])
  @@index([moduleId])
}

model MailAttachment {
  id               Int      @id @default(autoincrement())
  attachmentId     String   @unique @default(uuid())
  mailMessageId    Int?
  mailAccountId    Int?
  fileName         String
  mimeType         String
  fileSizeBytes    Int
  contentId        String?
  storagePath      String
  isEncrypted      Boolean  @default(false)
  envelopeMetadata Json?
  sha256Checksum   String
  scanStatus       String   @default("unknown")
  scanEngine       String?
  createdAt        DateTime @default(now())

  mailMessage MailMessage? @relation(fields: [mailMessageId], references: [id], onDelete: Cascade)
  mailAccount MailAccount? @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)

  @@index([mailMessageId])
  @@index([mailAccountId])
  @@index([attachmentId])
}

model EmailAuditLog {
  id           BigInt   @id @default(autoincrement())
  threadId     String
  messageId    String?
  actorId      Int?
  action       String
  ipAddress    String
  userAgent    String?
  details      Json     @default("{}")
  previousHash String
  entryHash    String
  createdAt    DateTime @default(now())

  actor User? @relation("EmailAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([actorId, createdAt])
}

// =============================================================================
// AGENTIC AI PERSISTENCE & SESSION LAYER (Phase 1)
// =============================================================================

enum AiSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  ARCHIVED
}

enum AiMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum AiToolStatus {
  PENDING
  SUCCESS
  ERROR
  TIMEOUT
}

enum AiIntentStatus {
  PROPOSED
  CONFIRMED
  REJECTED
  EXECUTED
  CANCELLED
}

enum AiAgentType {
  GENERAL_ASSISTANT
  FREELANCE_ADVISOR
  BI_ANALYST
  COURSE_TUTOR
  SUPPORT_AGENT
}

/// Agentic AI execution and conversation session
model AiSession {
  id                     String          @id @default(uuid())
  userId                 Int
  organizationId         Int?
  agentType              AiAgentType     @default(GENERAL_ASSISTANT)
  status                 AiSessionStatus @default(ACTIVE)
  title                  String?
  model                  String          @default("gemini-2.5-flash")
  systemPromptOverride   String?         @db.Text
  totalTokens            Int             @default(0)
  contextTokens          Int             @default(0)
  summaryState           String?         @db.Text
  compactedUntilSequence Int             @default(0)
  metadata               Json            @default("{}")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  deletedAt              DateTime?

  user          User             @relation("UserAiSessions", fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?    @relation("OrgAiSessions", fields: [organizationId], references: [id], onDelete: SetNull)
  messages      AiMessage[]
  toolTraces    AiToolTrace[]
  actionIntents AiActionIntent[]
  logs          AiLog[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([organizationId, createdAt])
  @@index([status, updatedAt])
  @@index([agentType, status])
}

/// Immutable record of conversation turns within an AI session
model AiMessage {
  id             String        @id @default(uuid())
  sessionId      String
  role           AiMessageRole
  content        String        @db.Text
  sequence       Int
  tokenCount     Int           @default(0)
  isCompacted    Boolean       @default(false)
  isSummary      Boolean       @default(false)
  model          String?
  finishReason   String?
  costMicroCents Int           @default(0)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  session       AiSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  toolTraces    AiToolTrace[]
  actionIntents AiActionIntent[]

  @@unique([sessionId, sequence])
  @@index([sessionId, isCompacted, sequence(sort: Asc)])
  @@index([sessionId, createdAt(sort: Asc)])
}

/// Observability & execution traces for tool calls dispatched by the agent
model AiToolTrace {
  id           String       @id @default(uuid())
  sessionId    String
  messageId    String?
  toolName     String
  toolCallId   String?
  inputArgs    Json
  outputResult Json?
  errorMessage String?      @db.Text
  status       AiToolStatus @default(PENDING)
  durationMs   Int?
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  createdAt    DateTime     @default(now())

  session AiSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message AiMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([sessionId, startedAt(sort: Desc)])
  @@index([toolName, status, startedAt])
  @@index([messageId])
}

/// Guardrail & Human-in-the-Loop (HITL) action intents proposed by AI
model AiActionIntent {
  id                    String         @id @default(uuid())
  sessionId             String
  messageId             String?
  intentType            String
  targetEntity          String?
  targetEntityId        String?
  payload               Json
  riskScore             Float          @default(0.0)
  status                AiIntentStatus @default(PROPOSED)
  requiresHumanApproval Boolean        @default(false)
  confirmedByUserId     Int?
  confirmedAt           DateTime?
  executedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  session     AiSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message     AiMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  confirmedBy User?      @relation("ConfirmedAiIntents", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([sessionId, status])
  @@index([status, requiresHumanApproval])
  @@index([confirmedByUserId, createdAt])
}

/// Immutable, tamper-evident SHA-256 hash-chained audit log & analytical flywheel
model AiLog {
  id               BigInt   @id @default(autoincrement())
  sessionId        String?
  userId           Int
  eventType        String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  latencyMs        Int      @default(0)
  model            String
  costMicroCents   Int      @default(0)
  ipAddress        String?
  userAgent        String?
  details          Json     @default("{}")
  previousHash     String
  entryHash        String
  createdAt        DateTime @default(now())

  session AiSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User       @relation("UserAiLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
}

enum KybStatus {
  NOT_SUBMITTED
  PENDING_VERIFICATION
  REQUIRES_CLARIFICATION
  APPROVED
  REJECTED
  SUSPENDED_FRAUD
}

enum CorporateDocumentType {
  CNRC_EXTRAIT_RC
  NIF_ATTESTATION
  DECLARATION_G8
  STATUTS_SOCIETE
  CARTE_AUTO_ENTREPRENEUR
  CARTE_ARTISAN
  PROCURATION_NOTARIEE
  ATTESTATION_CNAS_CASNOS
}

enum OrganizationRole {
  OWNER
  ADMIN
  BILLING_ADMIN
  HIRING_MANAGER
  ANALYST
  VIEWER
  AUDITOR
}

model OrganizationKyb {
  id                    Int       @id @default(autoincrement())
  organizationId        Int       @unique
  legalName             String
  tradeName             String?
  legalStructure        String // SARL, EURL, SPA, SNC, AUTO_ENTREPRENEUR
  shareCapitalDzd       BigInt?
  rcNumber              String    @unique
  rcWilayaCode          String
  rcDateImmatriculation DateTime?
  nifNumber             String    @unique
  nisNumber             String?
  articleImposition     String?
  taxRegime             String? // REEL, IFU
  headquartersAddress   String
  city                  City      @default(ALGIERS)
  status                KybStatus @default(NOT_SUBMITTED)
  riskScore             Int       @default(0)
  rejectionReason       String?
  verifiedAt            DateTime?
  verifiedBy            Int? // AdminProfile ID
  qrVerifiedAt          DateTime?
  qrVerificationReceipt Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verifierProfile  AdminProfile?        @relation("AdminKybVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
