  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  referredBy WaitlistEntry?  @relation("WaitlistReferrals", fields: [referredById], references: [id])
  referrals  WaitlistEntry[] @relation("WaitlistReferrals")

  @@index([email])
  @@index([referralCode])
  @@index([createdAt])
  @@index([status])
  @@index([referredById])
  @@index([status, createdAt])
