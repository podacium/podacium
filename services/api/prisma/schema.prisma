generator client {
  provider                    = "prisma-client-py"
  output                      = "../app/generated/prisma"
  enable_experimental_decimal = "true"
  recursive_type_depth        = -1
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Preserved for future licensed PSP operations under Bank of Algeria Regulation 25-02
model Wallet {
  id                 Int                 @id @default(autoincrement())
  userId             Int?                @unique
  organizationId     Int?                @unique
  podaPoints         Int                 @default(0)
  currency           String              @default("PODAPOINT")
  isActive           Boolean             @default(true)
  lastTopUpAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  escrowHolds        EscrowHold[] // Preserved for future licensed PSP operations under Bank of Algeria Regulation 25-02
  payouts            Payout[] // Preserved for future licensed PSP operations under Bank of Algeria Regulation 25-02
  walletTransactions Transaction[]
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       WalletTransaction[]

  @@index([userId])
  @@index([organizationId])
  @@index([podaPoints])
  @@index([isActive])
  @@index([createdAt])
}

/// Preserved for future licensed PSP operations under Bank of Algeria Regulation 25-02
model EscrowHold {
  id                 Int           @id @default(autoincrement())
  contractId         Int           @unique
  walletId           Int
  amount             Int
  currency           String        @default("DZD")
  status             String        @default("HOLD")
  releaseConditions  Json?
  scheduledReleaseAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  releasedAt         DateTime?
  refundedAt         DateTime?
  releasedAmount     Int           @default(0)
  wallet             Wallet        @relation(fields: [walletId], references: [id])
  transactions       Transaction[]

  @@index([contractId])
  @@index([walletId])
  @@index([status])
  @@index([scheduledReleaseAt])
  @@index([createdAt])
}

model WalletTransaction {
  id              Int            @id @default(autoincrement())
  walletId        Int
  amount          Int
  previousBalance Int
  newBalance      Int
  type            String
  purpose         PaymentPurpose
  referenceId     String?
  description     String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime?      @updatedAt
  wallet          Wallet         @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([referenceId])
  @@index([type])
  @@index([purpose])
  @@index([createdAt])
  @@index([walletId, createdAt])
}

model BusinessProfile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  headline          String?
  companyRole       String?
  department        String?
  industry          String?
  companySize       String?
  yearsOfExperience Int?
  areasOfExpertise  String[] @default([])
  linkedIn          String?
  portfolioUrl      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id])
  following   User     @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model OrgProfile {
  id                  Int          @id @default(autoincrement())
  organizationId      Int          @unique
  longDescription     String?
  specialties         String[]     @default([])
  technologies        String[]     @default([])
  competitors         String[]     @default([])
  fundingRound        String?
  fundingAmount       Float?
  revenueRange        String?
  products            Json?
  jobs                Json?
  culture             String?
  benefits            String?
  mission             String?
  achievements        Json?
  certifications      String[]     @default([])
  mapLocation         Json?
  algerianHealthScore Float?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model OrgReview {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  rating         Int
  title          String?
  comment        String?
  isRecommended  Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([rating])
}

model OrgFollow {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

/// Preserved for future licensed PSP operations under Bank of Algeria Regulation 25-02
model Payout {
  id                Int             @id @default(autoincrement())
  walletId          Int
  amount            Int
  currency          String          @default("DZD")
  method            PaymentProvider @default(BANK_TRANSFER)
  status            String          @default("PENDING")
  reference         String?
  metadata          Json?
  requestedAt       DateTime        @default(now())
  processedAt       DateTime?
  completedAt       DateTime?
  accountHolderName String?
  accountNumber     String?
  adminNotes        String?
  bankName          String?
  batchId           String?
  notes             String?
  wallet            Wallet          @relation(fields: [walletId], references: [id])
  updatedAt         DateTime?       @updatedAt

  @@index([walletId])
  @@index([status])
  @@index([requestedAt])
  @@index([method])
  @@index([reference])
  @@index([batchId])
}

model User {
  id                        Int                       @id @default(autoincrement())
  username                  String?                   @unique
  slug                      String?
  email                     String?                   @unique
  role                      UserRole                  @default(STUDENT)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  acceptedTerms             Boolean                   @default(false)
  bio                       String?
  headline                  String?
  tagline                   String?
  pronouns                  String?
  deletedAt                 DateTime?
  emailVerified             Boolean                   @default(false)
  emailVerifiedAt           DateTime?
  fullName                  String
  passwordHash              String?
  phoneNumber               String?                   @unique
  phoneVerified             Boolean                   @default(false)
  phoneVerifiedAt           DateTime?
  primaryOrganizationId     Int?
  profilePictureUrl         String?
  coverImageUrl             String?
  provider                  AuthProvider              @default(EMAIL)
  providerId                String?
  skills                    String[]                  @default([])
  /// Maintained by the arabic_search migration and app startup (tsvector is
  /// not natively supported by Prisma). Declared so `db push` never drops it.
  search_vector             Unsupported("tsvector")?
  socialLinks               Json?
  availability              String                    @default("AVAILABLE")
  timezone                  String?
  profileViewCount          Int                       @default(0)
  lastActiveAt              DateTime?
  subscribeNewsletter       Boolean                   @default(false)
  isActive                  Boolean                   @default(true)
  isDeactivated             Boolean                   @default(false)
  onboardingCompleted       Boolean                   @default(false)
  deactivatedAt             DateTime?
  lastLoginAt               DateTime?
  lastPasswordChangeAt      DateTime?
  loginCount                Int                       @default(0)
  country                   Country?
  city                      City?
  deletionRequests          AccountDeletionRequest[]
  advancedSettings          AdvancedSettings?
  authTokens                AuthToken[]
  platformAppeals           PlatformAppeal[]          @relation("UserPlatformAppeals")
  resolvedPlatformAppeals   PlatformAppeal[]          @relation("ResolvedPlatformAppeals")
  initiatedAdminActions     PendingAdminAction[]      @relation("InitiatedAdminActions")
  approvedAdminActions      PendingAdminAction[]      @relation("ApprovedAdminActions")
  conversationParticipants  ConversationParticipant[]
  dataExports               DataExport[]
  files                     File[]
  idempotencyKeys           IdempotencyKey[]
  sentInvitations           Invitation[]              @relation("SentInvitations")
  messages                  Message[]
  messageReactions          MessageReaction[]
  messageReadReceipts       MessageReadReceipt[]
  notifications             Notification[]
  notificationPrefs         NotificationPreferences?
  ownedOrganizations        Organization[]            @relation("OrgOwner")
  seatAllocations           SeatAllocation[]
  invoices                  Invoice[]
  sentInvites               OrganizationMember[]      @relation("OrgInvites")
  memberships               OrganizationMember[]      @relation("UserMemberships")
  paymentMethods            PaymentMethod[]
  securitySettings          SecuritySettings?
  subscriptions             Subscription[]
  transactions              Transaction[]
  usageTrackings            UsageTracking[]
  primaryOrganization       Organization?             @relation("PrimaryUsers", fields: [primaryOrganizationId], references: [id], onDelete: Restrict)
  devices                   UserDevice[]
  webauthnCredentials       WebAuthnCredential[]
  emailOtpCodes             EmailOtpCode[]
  securityEvents            SecurityEvent[]
  deviceCooldowns           DeviceCooldown[]
  securityStrikes           Int                       @default(0)
  accountRestricted         Boolean                   @default(false)
  accountRestrictedAt       DateTime?
  userSettings              UserSettings?
  appearanceSettings        AppearanceSettings?
  privacySettings           PrivacySettings?
  integrations              UserIntegration[]
  apiKeys                   ApiKey[]
  webhookEndpoints          WebhookEndpoint[]
  workflows                 IntegrationWorkflow[]
  skillsDetails             UserSkill[]
  wallet                    Wallet?
  onboardingAnswer          OnboardingAnswer?
  CrossPillarEvent          CrossPillarEvent[]
  tickets                   Ticket[]                  @relation("UserTickets")
  assignedTickets           Ticket[]                  @relation("AssignedTickets")
  ticketMessages            TicketMessage[]           @relation("TicketMessageSender")
  featurePurchases          FeaturePurchase[]         @relation("UserFeaturePurchases")
  businessProfile           BusinessProfile?
  followers                 UserFollow[]              @relation("Following")
  following                 UserFollow[]              @relation("Followers")
  blockedUsers              UserBlock[]               @relation("Blocker")
  blockedBy                 UserBlock[]               @relation("Blocked")
  usernameHistory           UsernameRedirect[]
  orgReviews                OrgReview[]
  orgFollows                OrgFollow[]
  videoUploadSessions       VideoUploadSession[]
  kyc                       UserKyc?
  adminProfile              AdminProfile?             @relation("UserAdminProfile")
  mailAccounts              MailAccount[]             @relation("UserMailAccounts")
  emailAuditLogs            EmailAuditLog[]           @relation("EmailAuditActor")
  aiSessions                AiSession[]               @relation("UserAiSessions")
  aiLogs                    AiLog[]                   @relation("UserAiLogs")
  confirmedAiIntents        AiActionIntent[]          @relation("ConfirmedAiIntents")
  startups                  Startup[]
  pledges                   VirtualPledge[]
  communityScores           CommunityScore[]
  quizResults               FinancialQuizResult[]


  @@index([search_vector], map: "user_search_idx", type: Gin)
  @@index([email])
  @@index([role, isActive, deletedAt])
  @@index([phoneVerified])
  @@index([skills])
  @@index([fullName])
  @@index([city, country])
  @@index([provider, providerId])
  @@index([lastLoginAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([isActive, role])
  @@index([emailVerified, email])
}

model UsernameRedirect {
  id          Int      @id @default(autoincrement())
  oldUsername String   @unique
  newUserId   Int
  changedAt   DateTime @default(now())
  expiresAt   DateTime
  user        User     @relation(fields: [newUserId], references: [id])

  @@index([oldUsername])
  @@index([expiresAt])
  @@index([newUserId])
}

model ReservedUsername {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model OnboardingAnswer {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  role            String?
  primaryGoal     String?
  experienceLevel String?
  fieldOfInterest String?
  weeklyTime      String?
  discoverySource String?
  openAnswer      String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Organization {
  id                 Int                  @id @default(autoincrement())
  slug               String?              @unique
  name               String
  description        String?
  website            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  ownerId            Int?
  city               City                 @default(ALGIERS)
  sector             OrganizationSector   @default(TECHNOLOGY_AND_SOFTWARE)
  country            Country              @default(ALGERIA)
  invitations        Invitation[]
  owner              User?                @relation("OrgOwner", fields: [ownerId], references: [id])
  members            OrganizationMember[]
  paymentMethods     PaymentMethod[]
  subscriptions      Subscription[]
  transactions       Transaction[]
  usageTrackings     UsageTracking[]
  primaryUsers       User[]               @relation("PrimaryUsers")
  wallet             Wallet?
  CrossPillarEvent   CrossPillarEvent[]
  orgProfile         OrgProfile?
  reviews            OrgReview[]
  followers          OrgFollow[]
  kyb                OrganizationKyb?
  departments        Department[]
  branches           Branch[]
  teamLicensePools   TeamLicensePool[]
  caseStudies        CompanyCaseStudy[]
  leadership         CompanyLeadership[]
  companyReviews     CompanyReview[]
  invoices           Invoice[]
  nisNumber          String?
  nifNumber          String?
  rcNumber           String?
  articleImposition  String?
  taxRegime          String?
  verifiedDomains    String[]             @default([])
  samlEntityId       String?
  samlMetadataUrl    String?
  scimEnabled        Boolean              @default(false)
  tagline            String?
  companySizeBracket String?              @default("MICRO_1_10")
  operationalScale   String?              @default("NATIONAL_58_WILAYAS")
  primaryLanguages   String[]             @default(["FRENCH", "ARABIC"])
  isPublic           Boolean              @default(true)
  internalBulletin   String?
  timeZone           String?              @default("Africa/Algiers")
  keyContacts        Json?
  hqAddress          String?
  brandAccentColor   String?              @default("#1B4D3E")
  coverBannerUrl     String?
  socialLinks        Json?
  mailAccounts       MailAccount[]        @relation("OrgMailAccounts")
  aiSessions         AiSession[]          @relation("OrgAiSessions")

  @@index([name])
  @@index([ownerId])
  @@index([createdAt])
  @@index([sector])
  @@index([country])
  @@index([city])
  @@index([isPublic])
}

model Invitation {
  id             Int          @id @default(autoincrement())
  email          String
  role           String       @default("MEMBER")
  token          String       @unique
  organizationId Int
  inviterId      Int
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  inviter        User         @relation("SentInvitations", fields: [inviterId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@index([token])
}

model OrganizationMember {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  role           String?
  invitedById    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  invitedBy      User?        @relation("OrgInvites", fields: [invitedById], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation("UserMemberships", fields: [userId], references: [id])
  departmentId   Int?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@index([invitedById])
  @@index([departmentId])
  @@index([createdAt])
}

enum MilestoneStatus {
  PENDING
  DELIVERED
  APPROVED
  DISPUTED
  RELEASED
}

model Transaction {
  id                   Int                 @id @default(autoincrement())
  userId               Int?
  organizationId       Int?
  amount               Int
  currency             String              @default("DZD")
  status               PaymentStatus       @default(PENDING)
  providerData         Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  checkoutUrl          String?
  commission           Int?
  contractId           Int?
  escrowHoldId         Int?
  freelancerPayout     Int?
  gateway              PaymentGateway      @default(MOCK)
  gatewayMetadata      Json?
  lastWebhookAttemptAt DateTime?
  metadata             Json?
  netAmount            Int?
  parentTransactionId  Int?
  provider             PaymentProvider     @default(CHARGILY)
  providerReference    String?             @unique
  purpose              PaymentPurpose
  subscriptionId       Int?
  walletId             Int?
  webhookAttempts      Int                 @default(0)
  webhookUrl           String?
  idempotencyKeys      IdempotencyKey[]
  paymentWebhookLogs   PaymentWebhookLog[]
  escrowHold           EscrowHold?         @relation(fields: [escrowHoldId], references: [id])
  organization         Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentTransaction    Transaction?        @relation("TransactionChildren", fields: [parentTransactionId], references: [id])
  childTransactions    Transaction[]       @relation("TransactionChildren")
  subscription         Subscription?       @relation(fields: [subscriptionId], references: [id])
  user                 User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet               Wallet?             @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([purpose])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
  @@index([contractId])
  @@index([subscriptionId])
  @@index([purpose, status])
  @@index([parentTransactionId])
  @@index([userId, purpose, status])
  @@index([gateway, status])
  @@index([checkoutUrl])
  @@index([webhookAttempts])
  @@index([createdAt, gateway])
  @@index([walletId])
  @@index([escrowHoldId])
  @@index([commission])
}

model Subscription {
  id                 Int                @id @default(autoincrement())
  userId             Int?
  organizationId     Int?
  plan               SubscriptionPlan
  startedAt          DateTime           @default(now())
  currentPeriodStart DateTime           @default(now())
  cancelledAt        DateTime?
  endsAt             DateTime?
  amount             Int
  billingCycle       String
  currency           String             @default("DZD")
  currentPeriodEnd   DateTime
  status             SubscriptionStatus @default(ACTIVE)
  autoRenew          Boolean            @default(true)
  paymentMethodId    Int?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  user               User?              @relation(fields: [userId], references: [id])
  paymentMethod      PaymentMethod?     @relation(fields: [paymentMethodId], references: [id])
  transactions       Transaction[]

  @@unique([userId, plan])
  @@unique([organizationId, plan])
  @@index([currentPeriodEnd])
  @@index([status])
}

model UserEntitlement {
  id              Int       @id @default(autoincrement())
  userId          Int
  entitlementType String
  resourceId      String?
  sourceType      String
  sourceId        String
  grantedAt       DateTime  @default(now())
  expiresAt       DateTime?

  @@unique([userId, entitlementType, resourceId])
  @@index([userId])
  @@index([expiresAt])
}

// @deprecated — preserved for future PSP-backed marketplace launch
model CommissionCalculation {
  id                Int            @id @default(autoincrement())
  contractId        Int            @unique
  grossAmount       Int
  freelancerTier    FreelancerTier
  commissionRate    Float
  commission        Int
  netAmount         Int
  tierJustification Json
  calculatedAt      DateTime       @default(now())
  updatedAt         DateTime?      @updatedAt

  @@index([contractId])
}

model CommissionTierHistory {
  id                Int            @id @default(autoincrement())
  freelancerId      Int
  tier              FreelancerTier
  commissionRate    Float
  completedProjects Int
  totalEarned       Int
  effectiveFrom     DateTime       @default(now())
  updatedAt         DateTime?      @updatedAt

  @@index([freelancerId, effectiveFrom])
}

// @deprecated — preserved for future PSP-backed marketplace launch
model PlatformRevenue {
  id          Int       @id @default(autoincrement())
  source      String
  amount      Int
  currency    String    @default("DZD")
  referenceId String?
  periodStart DateTime
  periodEnd   DateTime
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  @@index([source])
  @@index([periodStart, periodEnd])
  @@index([createdAt])
}

model EntitlementCache {
  id        String   @id
  userId    Int
  data      Json
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model PaymentMethod {
  id             Int             @id @default(autoincrement())
  userId         Int?
  organizationId Int?
  provider       PaymentProvider @default(CHARGILY)
  providerType   String
  providerId     String?
  isDefault      Boolean         @default(false)
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions  Subscription[]

  @@index([userId])
  @@index([organizationId])
  @@index([provider])
  @@index([isDefault])
  @@index([createdAt])
  @@index([providerId])
}

model UserSkill {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([name])
  @@index([userId, name])
  @@index([createdAt])
}

model ScheduledJob {
  id             Int       @id @default(autoincrement())
  jobType        String
  targetId       Int
  cronExpression String
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  status         String    @default("active")
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([jobType])
  @@index([status])
  @@index([nextRunAt])
}

model UsageTracking {
  id             Int           @id @default(autoincrement())
  userId         Int
  organizationId Int?
  metricType     String
  value          Int
  limit          Int
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime      @default(now())
  subscriptionId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metricType, periodStart])
  @@index([userId, metricType])
  @@index([organizationId])
  @@index([subscriptionId])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([userId, periodStart])
  @@index([organizationId, metricType])
  @@index([metricType, periodStart])
}

model Notification {
  id             Int                    @id @default(autoincrement())
  userId         Int
  type           String
  title          String?
  body           String
  data           Json?
  isRead         Boolean                @default(false)
  emailSent      Boolean                @default(false)
  emailSentAt    DateTime?
  createdAt      DateTime               @default(now())
  deletedAt      DateTime?
  category       NotificationCategory?
  priority       NotificationPriority   @default(NORMAL)
  expiresAt      DateTime?
  inAppDelivered Boolean                @default(false)
  pushSent       Boolean                @default(false)
  pushSentAt     DateTime?
  readAt         DateTime?
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries     NotificationDelivery[]

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
  @@index([category, createdAt])
  @@index([priority])
  @@index([emailSent])
  @@index([type])
  @@index([deletedAt])
  @@index([userId, createdAt])
  @@index([userId, category])
  @@index([userId, isRead, createdAt])
  @@index([expiresAt])
  @@index([userId, deletedAt, createdAt])
}

enum DisputeReason {
  NON_DELIVERY
  POOR_QUALITY
  INCOMPLETE_REQUIREMENTS
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CANCELLED
}

model NotificationDelivery {
  id             Int                        @id @default(autoincrement())
  notificationId Int
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  sentAt         DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  errorMessage   String?
  retryCount     Int                        @default(0)
  nextRetryAt    DateTime?
  externalId     String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
