model ContractReview {
  id           Int          @id @default(autoincrement())
  contractId   Int
  authorId     Int
  targetId     Int
  reviewType   ReviewType
  rating       Float
  subRatings   Json
  comment      String?
  status       ReviewStatus @default(ACTIVE)
  isPublic     Boolean      @default(false)
  lastEditedAt DateTime?
  editCount    Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract       @relation(fields: [contractId], references: [id])
  author   User           @relation("AuthoredReviews", fields: [authorId], references: [id])
  target   User           @relation("ReceivedReviews", fields: [targetId], references: [id])
  appeals  ReviewAppeal[]
  reports  ReviewReport[]

  @@unique([contractId, authorId])
  @@index([contractId])
  @@index([authorId])
  @@index([targetId])
}

model ReviewAppeal {
  id              Int          @id @default(autoincrement())
