# =============================================================================
# PODACIUM — Production Environment Variables
# =============================================================================
# Copy this file to .env.prod and fill in real values:
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# ALERTS: export these vars separately (not in .env) to keep webhook URLs
# out of Docker Compose env files:
#   export SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#   export PAGERDUTY_ROUTING_KEY=...
#   export OPS_EMAIL_TO=oncall@podacium.com
#   export OPS_EMAIL_FROM=alertmanager@podacium.com
#   export OPS_WEBHOOK_URL=https://hooks.example.com/opsgenie
#   export SMTP_HOST=smtp.example.com
#   export SMTP_PORT=587
#   export SMTP_USER=alertmanager@podacium.com
#   export SMTP_PASSWORD=...
# =============================================================================

# ── Database (NEVER store full DATABASE_URL with password) ────────────────────
# DATABASE_URL is constructed at container startup from these components.
# Do NOT add a DATABASE_URL line here.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=podacium
DB_USER=podacium
DB_PASSWORD_FILE=/run/secrets/db_password

# ── Redis ─────────────────────────────────────────────────────────────────────
# REDIS_PASSWORD must be set to a strong random value:
#   openssl rand -hex 32
# It must be the SAME across all Redis URLs below.
REDIS_PASSWORD=
REDIS_URL=redis://default:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://default:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://default:${REDIS_PASSWORD}@redis:6379/1

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
APP_NAME=Podacium API
BASE_URL=https://backend-api.podacium.com
FRONTEND_URL=https://podacium.com

# ── CORS (optional — override default allowed origins) ────────────────────────
# Comma-separated list. Defaults to https://www.podacium.com,https://podacium.com
# CORS_ORIGINS_RAW=https://www.podacium.com,https://podacium.com,https://admin.podacium.com

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=
SECRET_KEY=
OAUTH_STATE_SECRET=
# ⚠️  Prefer RS256 in production (asymmetric). HS256 is symmetric — if compromised,
#    all tokens can be forged. Set JWT_ALGORITHM=RS256 and provide JWT_PRIVATE_KEY
#    and JWT_PUBLIC_KEY (PEM format). The startup will block HS256 in production.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_DOMAIN=.podacium.com

# ── Edge Auth Secret (Next.js middleware JWT verification) ─────────────────────
# Used by the Edge middleware to verify the podacium_session cookie JWT.
# Must match the value used by the backend when signing session tokens.
# Generate with: openssl rand -hex 32
EDGE_AUTH_SECRET=

# ── OAuth ─────────────────────────────────────────────────────────────────────
FRONTEND_OAUTH_REDIRECT_URL=https://podacium.com/auth/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://backend-api.podacium.com/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://backend-api.podacium.com/api/v1/auth/oauth/github/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://backend-api.podacium.com/api/v1/auth/oauth/linkedin/callback

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false

# ── Payments ──────────────────────────────────────────────────────────────────
PAYMENT_GATEWAY=chargily
CHARGILY_API_KEY=
CHARGILY_SECRET_KEY=
CHARGILY_MODE=live
CHARGILY_WEBHOOK_SECRET=

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.1

# ── Turnstile (Bot Protection) ────────────────────────────────────────────────
TURNSTILE_SITE_KEY=0x4AAAAAAEwKsAwhy0wmVegg
TURNSTILE_SECRET_KEY=

# ── AI / Support Bot (Native Assistant & Crisp Webhook) ───────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CRISP_WEBHOOK_SECRET=
CRISP_WEBSITE_ID=

# ── LiveKit (Live Sessions & Replays) ─────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_SECRET=

# ── Video & Object Storage (AWS S3 & CloudFront / Supabase) ───────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_S3_VIDEO_BUCKET=
S3_BACKUP_BUCKET=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=/opt/podacium/secrets/cloudfront_private_key.pem
SUPABASE_URL=
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_BUCKET=Lesson

# ── Next.js Frontend (apps/web) ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://backend-api.podacium.com
NEXT_PUBLIC_BASE_URL=https://podacium.com
NEXTAUTH_URL=https://podacium.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEwKsAwhy0wmVegg
NEXT_PUBLIC_CRISP_WEBSITE_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Domain & Reverse Proxy ────────────────────────────────────────────────────
# Used by Caddy / Nginx for automatic Let's Encrypt certificates
DOMAIN=podacium.com
API_DOMAIN=backend-api.podacium.com
CADDY_ACME_EMAIL=admin@podacium.com

