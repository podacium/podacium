# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# PWA generated files
# /public/sw.js - tracked for SW deployment
/public/workbox-*.js
/public/workbox-*.js.map

# Generated certificates
/public/podacium-certificate-*.pdf

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.production

# typescript
*.tsbuildinfo
next-env.d.ts

#
.env
.env.local
services/api/.env
apps/web/.env.local

# Capacitor native platforms
/android/
/ios/