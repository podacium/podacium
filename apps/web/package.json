{
  "name": "@tamwheel/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "check-locales": "node ./scripts/check-all-locales.js",
    "audit:i18n": "node ./scripts/check-all-locales.js",
    "build": "tsc --noEmit && next build",
    "analyze": "ANALYZE=true next build",
    "build:standalone": "tsc --noEmit && STANDALONE=true next build",
    "start": "next start",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "capacitor:init": "npx cap init",
    "capacitor:sync": "npx cap sync",
    "capacitor:android": "npx cap open android",
    "capacitor:ios": "npx cap open ios",
    "capacitor:build:android": "next build && npx cap sync android",
    "capacitor:build:ios": "next build && npx cap sync ios"
  },
